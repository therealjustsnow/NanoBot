# NanoBot — environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in what you need. `.env` is gitignored.
#
# NanoBot's home is still `config.ini` — it is easier to read, it is what
# `!config set` edits from Discord, and it carries the comments explaining what
# every knob does. This file exists for the hosts where a file is the awkward
# way to configure a process: containers, PaaS dynos, systemd `EnvironmentFile`,
# CI. Nothing here is required if you have a config.ini.
#
# How the two fit together:
#
#   * `config.ini` is read first.
#   * Any `NANOBOT_<KEY>` variable then overrides that key for this process.
#   * `!config set` still reads and writes `config.ini`, so an environment
#     override is never written into the file and never silently edited away.
#     Start the bot and it tells you which keys the environment is overriding.
#
# Docker Compose reads this file automatically. For a bare process, load it with
# `set -a && . ./.env && set +a` or your service manager's own EnvironmentFile.

# ═════════════════════════════════════════════════════════════════════════════
#  Required — the bot cannot start without a token
# ═════════════════════════════════════════════════════════════════════════════

# Bot token from https://discord.com/developers/applications → Bot → Token.
# This one is not prefixed: it predates the NANOBOT_ scheme and `config.ini`'s
# `token` is the equivalent.
DISCORD_TOKEN=

# ═════════════════════════════════════════════════════════════════════════════
#  Optional — encryption at rest
# ═════════════════════════════════════════════════════════════════════════════

# Encrypts data/nanobot.db and data/cache.db through SQLCipher. Needs
# `sqlcipher3-binary` installed. A plaintext database is migrated on the first
# keyed start (the original is kept as *.plain.bak). Also not prefixed —
# `config.ini`'s `db_encryption_key` is the equivalent, and this wins over it.
#
# Losing this key means losing the database. Back it up somewhere the database
# backups are not.
NANOBOT_DB_KEY=

# ═════════════════════════════════════════════════════════════════════════════
#  The web dashboard (optional — off until dashboard_port is set)
#
#  Every key in config.ini's [dashboard] section can be set here by prefixing it
#  with NANOBOT_ and upper-casing it. The full list, with the same defaults:
# ═════════════════════════════════════════════════════════════════════════════

# Port to serve on. 0 (the default) disables the dashboard entirely.
NANOBOT_DASHBOARD_PORT=0

# Interface to bind. Behind a reverse proxy on the same host, prefer 127.0.0.1.
NANOBOT_DASHBOARD_HOST=0.0.0.0

# The public origin this API is reached at — scheme and host, no path. The OAuth
# redirect is built from it, so <base>/api/auth/callback must be registered in
# the Discord application's OAuth2 settings.
NANOBOT_DASHBOARD_BASE_URL=

# Where the browser app is served from, if not by the bot itself — e.g. a
# GitHub Pages URL. Blank (the default) means the bot serves it and there is one
# URL for everything. The OAuth callback always lands on the API above (only it
# has the client secret); this is where the browser is sent afterwards.
NANOBOT_DASHBOARD_FRONTEND_URL=

# OAuth credentials. Leave the id blank to use the bot's own application id.
# The secret is under OAuth2 → Client Secret in the developer portal.
NANOBOT_DASHBOARD_CLIENT_ID=
NANOBOT_DASHBOARD_CLIENT_SECRET=

# Signs session cookies. Blank means a fresh random one per start, which signs
# everyone out on every restart — and this bot restarts on `!upgrade`. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NANOBOT_DASHBOARD_SESSION_SECRET=

# How long a sign-in lasts, in days.
NANOBOT_DASHBOARD_SESSION_DAYS=7

# Whether the economy is playable from the browser. False makes the dashboard
# read-only for members while leaving it fully configurable for admins.
NANOBOT_DASHBOARD_PLAY_ENABLED=true

# Origins allowed to call this API cross-origin — only needed when the frontend
# is hosted somewhere other than this bot (GitHub Pages, a CDN, a laptop).
# Space- or comma-separated, scheme included, no trailing path. Setting it
# switches the session cookie to SameSite=None; Secure, so production entries
# must be https:// (http://localhost is fine in development).
#
#   NANOBOT_DASHBOARD_ALLOWED_ORIGINS=https://yourname.github.io http://localhost:8080
NANOBOT_DASHBOARD_ALLOWED_ORIGINS=

# ═════════════════════════════════════════════════════════════════════════════
#  Frontend build (GitHub Pages / any static host)
#
#  These are *not* read by the bot. They are read when assembling the static
#  site — by `.github/workflows/pages.yml`, where they live as repository
#  variables (Settings → Secrets and variables → Actions → Variables), and by
#  `scripts/build_dashboard.sh` when you build locally. Both do the same thing:
#  write `assets/config.json` into the copied site.
#
#  Neither is a secret. The frontend holds no credentials — it talks to the API
#  with a cookie the API itself issued.
# ═════════════════════════════════════════════════════════════════════════════

# Origin of the NanoBot API the deployed frontend should call. Empty means
# same-origin, which is correct when the bot serves the frontend itself.
#   https://bot.example.com
NANOBOT_API_BASE=

# Path prefix the site is served under. A GitHub Pages project site lives at
# /<repo>, so that is the default; a user site or a custom domain serves from
# the root and wants an empty value.
#   /NanoBot
NANOBOT_BASE_PATH=
